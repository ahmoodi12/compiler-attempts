cxx = ccache clang++

llvm_cxxflags = -I/home/ahmad/LLVM/include -D_GNU_SOURCE -DEXPERIMENTAL_KEY_INSTRUCTIONS -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS

cxxflags = $llvm_cxxflags -std=c++20 -g -O0

ldflags = -L/home/ahmad/LLVM/lib -lLLVMIRReader -lLLVMBitReader -lLLVMAsmParser -lLLVMCore -lLLVMRemarks -lLLVMBitstreamReader -lLLVMBinaryFormat -lLLVMTargetParser -lLLVMSupport -lLLVMDemangle -lrt -ldl -lm -lz -lzstd -lxml2

rule compile
  command = $cxx $cxxflags -c $in -o $out
  description = CXX $in

rule link
  command = $cxx $in $ldflags -o $out
  description = LINK $out

build main.o:             compile ../../main.cpp
build compiler.o:         compile ../../compiler.cpp
build utils.o:            compile ../../utils.cpp
build frontend.o:         compile ../../frontend.cpp
build data_structures.o:  compile ../../data_structures.cpp
build data.o:             compile ../../data.cpp

build main: link main.o compiler.o utils.o frontend.o data_structures.o data.o
