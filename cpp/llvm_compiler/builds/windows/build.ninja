# Compiler and LLVM paths
cxx = "C:/Program Files/LLVM/bin/clang++.exe"
llvm_root = C:/llvm_rtti

# Compiler flags
llvm_cxxflags = -I$llvm_root/include -D_GNU_SOURCE -DEXPERIMENTAL_KEY_INSTRUCTIONS -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS
cxxflags = $llvm_cxxflags -std=c++20 -g -O0 -MD

# Linker flags
ldflags = -L$llvm_root/lib -lLLVMCore -lLLVMSupport -lLLVMIRReader -lLLVMBitReader -lLLVMAsmParser -lLLVMRemarks -lLLVMBitstreamReader -lLLVMBinaryFormat -lLLVMTargetParser -lLLVMDemangle

# Compilation pool
pool compile_pool
  depth = 8

# Compile rule
rule compile
  command = $cxx $cxxflags -c $in -o $out
  description = CXX $in
  pool = compile_pool

# Link rule
rule link
  command = $cxx $in $ldflags -o $out
  description = LINK $out

# Object files
build main.o: compile ..\..\main.cpp
build compiler.o: compile ..\..\compiler.cpp
build utils.o: compile ..\..\utils.cpp
build frontend.o: compile ..\..\frontend.cpp
build data_structures.o: compile ..\..\data_structures.cpp
build data.o: compile ..\..\data.cpp

# Final executable
build main: link main.o compiler.o utils.o frontend.o data_structures.o data.o
